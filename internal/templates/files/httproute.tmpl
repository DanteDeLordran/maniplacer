apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ .name | Quote }}
  namespace: {{ .namespace | Quote }}
spec:
  parentRefs:
    - kind: Gateway
      name: {{ .gatewayName | Quote }}
      namespace: {{ .gatewayNamespace | Quote }}
  hostnames:
    - {{ .hostname | Quote }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: {{ .pathPrefix | Quote }}
      backendRefs:
        - kind: Service
          name: {{ .name | Quote }}
          port: {{ .servicePort }}
          weight: 100
