apiVersion: v1
kind: Service
metadata:
  name: {{ .name | Quote }}
  namespace: {{ .namespace | Quote }}
  labels:
    app.kubernetes.io/name: {{ .name | Quote }}
spec:
  selector:
    app.kubernetes.io/name: {{ .name | Quote }}
  ports:
    - name: http
      protocol: TCP
      port: {{ .servicePort }}
      targetPort: {{ .containerPort }}
  type: ClusterIP
